{
  "name": "starlight-aurora",
  "version": "0.3.0",
  "description": "Aurora, the Colliery design system, as an Astro Starlight theme",
  "license": "Apache-2.0",
  "repository": "github:colliery-io/starlight-aurora",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./styles/*": "./styles/*",
    "./vendor/*": "./vendor/*",
    "./components/*": "./components/*",
    "./mdbook-redirects": {
      "types": "./mdbook-redirects.d.ts",
      "default": "./mdbook-redirects.js"
    },
    "./redirects": {
      "types": "./redirects.d.ts",
      "default": "./redirects.js"
    },
    "./c4-colours.js": "./c4-colours.js",
    "./scripts/*": "./scripts/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "styles",
    "components",
    "vendor",
    "mdbook-redirects.js",
    "mdbook-redirects.d.ts",
    "redirects.js",
    "redirects.d.ts",
    "c4-colours.js",
    "scripts/check-links.mjs",
    "scripts/check-site.mjs",
    "scripts/cli.mjs",
    "scripts/mdbook-to-starlight.mjs"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0",
    "starlight-versions": ">=0.10.0",
    "playwright-core": ">=1.40.0",
    "axe-core": ">=4.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:vendor": "node scripts/vendor.mjs check",
    "vendor:update": "node scripts/vendor.mjs update",
    "template:check": "scripts/check-template.sh",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:check": "node scripts/check-build.mjs docs/dist && node scripts/check-links.mjs docs/dist && node scripts/check-site.mjs docs/dist --hyper --versions",
    "check:upstream": "node scripts/check-upstream.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.0",
    "starlight-versions": "^0.10.1"
  },
  "peerDependenciesMeta": {
    "starlight-versions": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    }
  },
  "bin": {
    "starlight-aurora-check-links": "scripts/check-links.mjs",
    "starlight-aurora-check-site": "scripts/check-site.mjs",
    "starlight-aurora-from-mdbook": "scripts/mdbook-to-starlight.mjs"
  }
}
