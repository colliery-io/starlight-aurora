{
  "name": "starlight-aurora",
  "version": "0.1.0",
  "description": "Aurora, the Colliery design system, as an Astro Starlight theme",
  "license": "Apache-2.0",
  "repository": "github:colliery-io/starlight-aurora",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./styles/*": "./styles/*",
    "./vendor/*": "./vendor/*",
    "./components/*": "./components/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "styles",
    "components",
    "vendor"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0",
    "starlight-versions": ">=0.10.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:vendor": "node scripts/vendor.mjs check",
    "vendor:update": "node scripts/vendor.mjs update",
    "template:check": "scripts/check-template.sh",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:check": "node scripts/check-build.mjs docs/dist && node scripts/check-site.mjs docs/dist --hyper --versions"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.0",
    "starlight-versions": "^0.10.1"
  },
  "peerDependenciesMeta": {
    "starlight-versions": {
      "optional": true
    }
  }
}
